{
  "name": "tauri-app",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "db:reset": "powershell -Command \"Remove-Item -Force -ErrorAction SilentlyContinue \\\"$env:APPDATA\\com.syntrok.infranet\\infranet.db\\\", \\\"$env:APPDATA\\com.syntrok.infranet\\infranet.db-wal\\\", \\\"$env:APPDATA\\com.syntrok.infranet\\infranet.db-shm\\\"\"",
